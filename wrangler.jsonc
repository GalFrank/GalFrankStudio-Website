// Cloudflare Workers config: serves the repo root as a static site, plus worker/index.js for the
// contact form (POST /api/contact). Static files are served first; the Worker only sees requests
// that match no file. "name" must match the Worker name in the Cloudflare dashboard or the build fails.
// Files listed in .assetsignore are never published.
{
  "name": "galfrankstudio-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "vars": {
    "CONTACT_TO": "GalFrankStudio@gmail.com",
    "CONTACT_FROM": "website@galfrank.com"
  },
  // Contact form email (worker/index.js → env.EMAIL). GalFrankStudio@gmail.com is a verified destination in
  // Cloudflare → Email Service → Email Routing, and galfrank.com has Email Routing on, so sending to it is free.
  // The binding can only ever send to that one address. Without it, the form offers WhatsApp instead.
  "send_email": [{ "name": "EMAIL", "destination_address": "GalFrankStudio@gmail.com" }],
  // Required by the pull-request preview builds (`wrangler preview`); empty = same settings as production.
  "previews": {}
}
